LANGUAGE LANG_RUSSIAN, SUBLANG_RUSSIAN_RUSSIA
IDD_SETTINGS_RU DIALOGEX 0, 0, 650, 382
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Настройки NetWatch"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Группы", -1, 10, 9, 170, 12
    LISTBOX IDC_GROUPS, 10, 24, 170, 113, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    PUSHBUTTON "Добавить", IDC_GROUP_ADD, 10, 141, 39, 15
    PUSHBUTTON "Удалить", IDC_GROUP_DELETE, 52, 141, 42, 15
    PUSHBUTTON "Выше", IDC_GROUP_UP, 97, 141, 39, 15
    PUSHBUTTON "Ниже", IDC_GROUP_DOWN, 139, 141, 41, 15
    LTEXT "Название", -1, 10, 166, 40, 10
    EDITTEXT IDC_GROUP_NAME, 52, 163, 128, 15, ES_AUTOHSCROLL
    LTEXT "Метка", -1, 10, 188, 40, 10
    EDITTEXT IDC_GROUP_LABEL, 52, 185, 128, 15, ES_AUTOHSCROLL
    CONTROL "Проверять эту группу", IDC_GROUP_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 207, 170, 13
    CONTROL "Показывать на панели задач", IDC_GROUP_VISIBLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 225, 170, 13
    LTEXT "Лимит видимых групп", -1, 10, 249, 140, 12
    COMBOBOX IDC_LIMIT, 10, 265, 100, 90, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT "Все или 0-4096. Скрытые группы тоже можно проверять.", -1, 10, 288, 170, 29
    LTEXT "Проверки выбранной группы", -1, 194, 9, 270, 12
    LISTBOX IDC_CHECKS, 194, 24, 446, 68, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    PUSHBUTTON "Добавить", IDC_CHECK_ADD, 194, 98, 69, 15
    PUSHBUTTON "Удалить", IDC_CHECK_DELETE, 269, 98, 73, 15
    LTEXT "Название", -1, 194, 125, 43, 10
    EDITTEXT IDC_CHECK_NAME, 245, 122, 213, 15, ES_AUTOHSCROLL
    LTEXT "Тип", -1, 471, 125, 28, 10
    COMBOBOX IDC_CHECK_KIND, 506, 122, 134, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Узел / URL", -1, 194, 148, 48, 10
    EDITTEXT IDC_CHECK_TARGET, 245, 145, 395, 15, ES_AUTOHSCROLL
    LTEXT "Порт TCP", -1, 194, 172, 49, 10
    EDITTEXT IDC_CHECK_PORT, 245, 169, 58, 15, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "Интервал (с)", -1, 315, 172, 54, 10
    EDITTEXT IDC_CHECK_INTERVAL, 372, 169, 60, 15, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "Тайм-аут (мс)", -1, 448, 172, 70, 10
    EDITTEXT IDC_CHECK_TIMEOUT, 523, 169, 117, 15, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL "Включена", IDC_CHECK_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 194, 194, 105, 13
    PUSHBUTTON "Проверить сейчас (черновик)", IDC_TEST, 506, 191, 134, 17
    LTEXT "Результат ручной проверки (не меняет историю мониторинга)", -1, 194, 218, 446, 12
    EDITTEXT IDC_RESULT, 194, 234, 446, 76, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "Изменения индикаторов требуют перезапуска TrafficMonitor. Изменения проверок действуют после сохранения. Сетевые проверки выполняются в фоне; окно можно закрыть.", IDC_NOTICE, 10, 328, 470, 24
    PUSHBUTTON "Справка", IDC_OPEN_HELP, 10, 353, 68, 19
    DEFPUSHBUTTON "Сохранить", IDOK, 497, 353, 68, 19
    PUSHBUTTON "Отмена", IDCANCEL, 572, 353, 68, 19
END
IDD_HELP_RU DIALOGEX 0, 0, 450, 280
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Справка NetWatch"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT IDC_HELP_TEXT, 10, 10, 430, 233, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Закрыть", IDOK, 372, 251, 68, 19
END
// Russian strings use the English resource ID plus 1000.
STRINGTABLE
BEGIN
    1200 "Введите целое число в допустимом диапазоне."
    1201 "Все слоты проверок заняты (4 одновременно, 4 запуска в секунду). Повторите позже."
    1202 "Проверка выполняется в фоне..."
    1203 "Не удалось сохранить настройки: "
    1204 "Не удалось загрузить прежние настройки. Сохранение заменит их."
    1205 "Сохранено. Перезапустите TrafficMonitor, чтобы применить изменения индикаторов: названия, метки, порядок, видимость и лимит групп. Новые индикаторы включите в настройках панели задач TrafficMonitor."
    1206 "Все"
    1207 "Новая группа"
    1208 "Новая проверка"
    1209 "Непредвиденная ошибка"
    1210 "НАЧАЛО РАБОТЫ\r\nГруппа объединяет проверки в один индикатор на панели задач. Название помогает найти группу в настройках; метка выводится рядом с кружком. Выберите группу, добавьте проверку, укажите тип и адрес, затем сохраните. Публичные адреса автоматически не добавляются."
    1211 "ТИПЫ ПРОВЕРОК\r\nICMP: имя узла или IP-адрес без http://. Проверяется ответ на эхо-запрос; некоторые узлы блокируют ICMP, хотя их службы работают. TCP: имя узла/IP и порт (например, 127.0.0.1 и 80). Успех означает, что порт принимает подключения, но не гарантирует исправность приложения. HTTP/HTTPS: полный URL с http:// или https://. Отправляется GET; успешны только статусы 2xx. Переходы по перенаправлениям не выполняются. Сертификат TLS проверяется."
    1212 "ЦВЕТА ИНДИКАТОРА\r\nЗелёный: все включённые проверки доступны. Жёлтый: часть доступна, часть недоступна. Красный: все включённые проверки недоступны. Серый: хотя бы у одной включённой проверки нет актуального результата, нет включённых проверок или мониторинг группы отключён. Три ошибки подряд переводят проверку в состояние «недоступно»; один успех восстанавливает доступность. Первые две ошибки до первого успеха оставляют состояние неизвестным. Отключённые проверки не учитываются."
    1213 "ИНТЕРВАЛ И ТАЙМ-АУТ\r\nИнтервал (1-86400 секунд) задаёт частоту запуска проверок. Тайм-аут (100-30000 миллисекунд) ограничивает время сетевого обмена. По умолчанию: 30 секунд и 2000 мс. Завершение обратных вызовов ОС/DNS может занять больше времени. Устаревшие результаты становятся серыми: срок актуальности равен большему из трёх интервалов и суммы интервала с тайм-аутом. Учитывается свежесть результата и последнего успеха. Ограничения: 4 одновременные проверки и 4 запуска в секунду, включая ручные. При большом числе проверок возможны задержки и серые индикаторы."
    1214 "МОНИТОРИНГ И ОТОБРАЖЕНИЕ\r\n«Проверять эту группу» управляет запуском проверок. «Показывать на панели задач» и лимит видимых групп управляют передачей индикаторов хосту; скрытые группы тоже можно проверять. «Все» снимает лимит, 0 скрывает все группы. Изменение состава индикаторов, их названий, меток или порядка требует перезапуска TrafficMonitor. После сохранения напоминание появляется, пока эти изменения отличаются от загруженного набора. Новые индикаторы включите в настройках панели задач TrafficMonitor. Изменения самих проверок действуют после сохранения без перезапуска."
    1215 "РУЧНАЯ ПРОВЕРКА И СОХРАНЕНИЕ\r\n«Проверить сейчас (черновик)» проверяет текущие поля без сохранения и изменения истории мониторинга. Успех здесь не делает кружок на панели задач зелёным сразу. Результат содержит ICMP RTT, время подключения TCP или время ответа HTTP до заголовков; «нет данных» означает отсутствие измерения. Ошибочный статус HTTP тоже может сопровождаться временем ответа. «Сохранить» записывает настройки и применяет изменения мониторинга, очищая прежние результаты. «Отмена» отбрасывает несохранённые правки. Закрытие любого из окон не отменяет фоновые проверки. Справка также открывается по F1 и работает без интернета."
    1216 "ЕСЛИ ПРОВЕРКА НЕ ПРОШЛА\r\nОшибка DNS: проверьте имя узла и разрешение имён. В подключении отказано: проверьте порт TCP и наличие службы на нём. Тайм-аут: узел или служба могут быть недоступны, отфильтрованы или отвечать медленнее заданного времени. Ошибка TLS: проверьте имя узла в URL, доверие к сертификату и системное время; отключить проверку сертификата нельзя. Ошибка HTTP: посмотрите возвращённый статус. Числовые коды ошибок сохраняются в результатах и подсказках. Старые названия групп и проверок не переводятся автоматически, поскольку это пользовательские данные."
END
