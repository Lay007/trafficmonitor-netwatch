LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
2100 DIALOGEX 0, 0, 650, 382
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "NetWatch 设置"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT "分组", -1, 10, 9, 170, 12
    LISTBOX IDC_GROUPS, 10, 24, 170, 113, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    PUSHBUTTON "添加", IDC_GROUP_ADD, 10, 141, 39, 15
    PUSHBUTTON "删除", IDC_GROUP_DELETE, 52, 141, 42, 15
    PUSHBUTTON "上移", IDC_GROUP_UP, 97, 141, 39, 15
    PUSHBUTTON "下移", IDC_GROUP_DOWN, 139, 141, 41, 15
    LTEXT "名称", -1, 10, 166, 40, 10
    EDITTEXT IDC_GROUP_NAME, 52, 163, 128, 15, ES_AUTOHSCROLL
    LTEXT "标签", -1, 10, 188, 40, 10
    EDITTEXT IDC_GROUP_LABEL, 52, 185, 128, 15, ES_AUTOHSCROLL
    CONTROL "监测此组", IDC_GROUP_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 207, 170, 13
    CONTROL "在任务栏显示", IDC_GROUP_VISIBLE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 225, 170, 13
    LTEXT "可见分组上限", -1, 10, 249, 100, 12
    COMBOBOX IDC_LIMIT, 10, 265, 100, 90, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT "全部或 0-4096。隐藏分组仍可监测。", -1, 10, 288, 170, 29
    LTEXT "所选分组的检测项", -1, 194, 9, 270, 12
    CONTROL "", IDC_CHECKS, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 194, 24, 446, 100
    PUSHBUTTON "添加检测", IDC_CHECK_ADD, 194, 130, 69, 15
    PUSHBUTTON "删除检测", IDC_CHECK_DELETE, 269, 130, 73, 15
    LTEXT "名称", -1, 194, 157, 43, 10
    EDITTEXT IDC_CHECK_NAME, 245, 154, 213, 15, ES_AUTOHSCROLL
    LTEXT "类型", -1, 471, 157, 28, 10
    COMBOBOX IDC_CHECK_KIND, 506, 154, 134, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "主机 / URL", -1, 194, 180, 48, 10
    EDITTEXT IDC_CHECK_TARGET, 245, 177, 395, 15, ES_AUTOHSCROLL
    LTEXT "TCP 端口", -1, 194, 204, 49, 10
    EDITTEXT IDC_CHECK_PORT, 245, 201, 58, 15, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "间隔（秒）", -1, 315, 204, 54, 10
    EDITTEXT IDC_CHECK_INTERVAL, 372, 201, 60, 15, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "超时（毫秒）", -1, 448, 204, 70, 10
    EDITTEXT IDC_CHECK_TIMEOUT, 523, 201, 117, 15, ES_AUTOHSCROLL | ES_NUMBER
    CONTROL "启用", IDC_CHECK_ENABLED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 194, 226, 105, 13
    PUSHBUTTON "立即检测（草稿）", IDC_TEST, 506, 223, 134, 17
    LTEXT "手动检测结果（不更改监测历史）", -1, 194, 250, 446, 12
    EDITTEXT IDC_RESULT, 194, 266, 446, 44, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "指示器显示更改需要重启 TrafficMonitor。检测更改在保存后生效。网络检测在后台运行，可以关闭此窗口。", IDC_NOTICE, 10, 328, 470, 24
    PUSHBUTTON "帮助", IDC_OPEN_HELP, 10, 353, 68, 19
    PUSHBUTTON "导入 SSH...", IDC_IMPORT_SSH, 84, 353, 90, 19
    PUSHBUTTON "标准分组", IDC_DEFAULT_GROUPS, 180, 353, 100, 19
    DEFPUSHBUTTON "保存", IDOK, 497, 353, 68, 19
    PUSHBUTTON "取消", IDCANCEL, 572, 353, 68, 19
END
2500 DIALOGEX 0, 0, 560, 300
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "导入 OpenSSH 主机"
FONT 9, "Microsoft YaHei UI"
BEGIN
    EDITTEXT IDC_SSH_PATH, 10, 10, 540, 15, ES_READONLY | ES_AUTOHSCROLL
    LTEXT "添加到分组", -1, 10, 36, 90, 12
    COMBOBOX IDC_SSH_GROUP, 108, 33, 300, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "", IDC_SSH_HOSTS, "SysListView32", LVS_REPORT | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 10, 58, 540, 177
    LTEXT "勾选需要的主机。仅添加 TCP 端口检测，不登录 SSH 或使用密钥。跳过项和重复项不会导入。在设置中保存后生效；取消将放弃导入。", -1, 10, 242, 540, 26
    DEFPUSHBUTTON "添加所选项", IDOK, 382, 273, 90, 17
    PUSHBUTTON "取消", IDCANCEL, 480, 273, 70, 17
END
2300 DIALOGEX 0, 0, 450, 280
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "NetWatch 帮助"
FONT 9, "Microsoft YaHei UI"
BEGIN
    EDITTEXT IDC_HELP_TEXT, 10, 10, 430, 233, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "关闭", IDOK, 372, 251, 68, 19
END
STRINGTABLE
BEGIN
    2200 "请输入允许范围内的整数。"
    2201 "检测资源已占满（最多同时 4 项，每秒启动 4 项）。请稍后重试。"
    2202 "正在后台检测..."
    2203 "无法保存配置："
    2204 "无法加载原配置。保存将替换该文件。"
    2205 "已保存。请重启 TrafficMonitor，以应用指示器的名称、标签、顺序、可见性和分组上限。在 TrafficMonitor 的任务栏选项中启用新增项。"
    2206 "全部"
    2207 "新分组"
    2208 "新检测"
    2209 "意外错误"
    2217 "导入 SSH 主机\r\n选择已有的 OpenSSH 配置文件，默认位置为 Windows 用户目录的 .ssh/config。预览 Host 别名、地址、端口，选择目标分组并勾选需要的行。仅创建 TCP 端口检测，不登录 SSH，不使用密钥或运行命令。默认端口为 22，遵循 Host 模式与首个值优先规则。Include 支持本地路径和文件名通配符；相对路径基于用户目录的 .ssh。Match 不受支持。ProxyJump/ProxyCommand 及不支持的主机名变量会被跳过。重复别名或地址/端口不会覆盖同组旧检测。保存前仅修改草稿。"
    2218 "标准分组\r\n首次运行且没有保存的文件时，创建空的 LOCAL、WEB 和 SSH 分组，名称使用所选语言，不添加目标。“标准分组”仅向草稿添加缺少的标签，保留现有分组、检测和 ID，包括保留这些标签的已重命名分组。取消放弃新增内容，保存则写入配置。实际指示器列表更改需要重启 TrafficMonitor。"
    2219 "选择 OpenSSH 配置文件"
    2220 "创建新 SSH 分组"
    2221 "未找到具体的 Host 别名。仅含通配符的 Host 段可提供默认值，但不能列出主机。"
    2222 "请至少勾选一个就绪主机。无法导入跳过项和重复项。"
    2223 "SSH 主机已作为 TCP 检测添加到草稿。请检查并保存以开始监测，或取消以放弃更改。"
    2224 "缺少的标准分组已添加到草稿。原有标签、分组和检测项均已保留。请保存以保留更改。"
    2225 "无法导入 OpenSSH 配置："
    2210 "入门\r\n分组将多个检测项汇总为一个任务栏指示器。名称用于在设置中识别分组，标签显示在圆点旁。选择分组，添加检测，设置类型和目标，然后保存。不会自动添加公共目标。"
    2211 "检测类型\r\nICMP：输入主机名或 IP 地址，不带 URL 前缀。检测回显响应；某些主机即使服务正常也会阻止 ICMP。TCP：输入主机/IP 和端口，例如 127.0.0.1 和 80。连接成功仅表示端口接受连接，不保证应用正常。HTTP/HTTPS：输入完整的 http:// 或 https:// URL。发送 GET，仅 2xx 状态视为成功，不跟随重定向。始终验证 TLS 证书。"
    2212 "指示器颜色\r\n绿色：所有已启用检测均可用。黄色：部分可用，部分不可用。红色：所有已启用检测均不可用。灰色：至少一项检测没有当前有效结果、没有已启用的检测，或该组监测已禁用。连续失败三次才确认不可用；成功一次即恢复可用。首次成功前的前两次失败仍显示未知。已禁用的检测不参与汇总。"
    2213 "间隔与超时\r\n间隔为 1-86400 秒，决定检测调度频率；超时为 100-30000 毫秒，限制网络操作时间。默认值为 30 秒和 2000 ms。系统/DNS 回调清理可能耗时更长。结果过期后变灰；有效期为三个间隔与一个间隔加超时中的较大值，同时考虑结果和最后一次成功的新鲜度。包括手动检测在内，最多同时运行 4 项，每秒启动 4 项。配置较大时可能延迟并变灰。"
    2214 "监测与显示\r\n“监测此组”控制检测运行。“在任务栏显示”和可见分组上限决定向主程序提供哪些指示器；隐藏分组仍可监测。“全部”表示不限，0 隐藏所有组。更改实际指示器列表、名称、标签或顺序需要重启 TrafficMonitor。保存时仅在待应用布局与已加载布局不同时提醒重启。请在 TrafficMonitor 的任务栏设置中启用新增指示器。仅更改检测项时，保存后即可生效，无需重启。"
    2215 "手动检测与保存\r\n“立即检测（草稿）”检测当前编辑内容，不保存也不更改监测历史。手动成功不会立即让任务栏圆点变绿。结果显示 ICMP RTT、TCP 连接耗时或 HTTP 响应头到达时间；“无数据”表示未取得测量值。HTTP 错误状态也可能带有响应时间。保存会写入配置并应用监测更改，清除旧结果。取消放弃未保存的编辑。关闭任一窗口不会取消后台检测。按 F1 也可打开帮助；帮助无需联网。\r\n\r\n检测表每秒刷新两次已保存配置的监测结果：状态、ICMP/TCP/HTTP 耗时（毫秒）、含原始错误码的上次结果和本地检测时间。短横线表示没有结果或测量值。已过期表示结果已超过有效期。检测中或已过期的行保留上次结果。未保存的行在保存前不显示实时结果，手动检测结果单独显示。选择行进行编辑，可调整列宽。"
    2216 "检测失败时\r\nDNS 错误：检查主机名及名称解析。连接被拒绝：检查 TCP 端口和监听服务。超时：主机/服务可能不可达、被过滤，或响应超过设置的时限。TLS 错误：检查 URL 主机、证书信任和系统时间；不能跳过证书验证。HTTP 错误：查看返回的状态码。结果与提示保留原始数字错误码。已保存的分组和检测名称是用户数据，不会自动翻译。"
END
